  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Get hotels - Delhi (with overlap)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/hotels?city=delhi"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response is an array', function () { pm.expect(body).to.be.an('array'); });",
                  "pm.test('hotel names are unique case-insensitively', function () {",
                  "  const names = body.map((hotel) => hotel.name.toLowerCase());",
                  "  pm.expect(new Set(names).size).to.equal(names.length);",
                  "});",
                  "pm.test('at least one cheaper overlapping offer is from Supplier B', function () {",
                  "  // Delhi seeds dedupe to six offers; Supplier B is cheaper for The Grand Palace and Lotus Residency.",
                  "  pm.expect(body.some((hotel) => hotel.supplier === 'Supplier B')).to.be.true;",
                  "});",
                  "pm.test('every offer has the expected field types', function () {",
                  "  body.forEach((hotel) => {",
                  "    pm.expect(hotel).to.have.property('name').that.is.a('string');",
                  "    pm.expect(hotel).to.have.property('price').that.is.a('number');",
                  "    pm.expect(hotel).to.have.property('supplier').that.is.a('string');",
                  "    pm.expect(hotel).to.have.property('commissionPct').that.is.a('number');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get hotels - Delhi with price filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/hotels?city=delhi&minPrice=90&maxPrice=120"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('every price is within the inclusive range', function () {",
                  "  body.forEach((hotel) => pm.expect(hotel.price).to.be.within(90, 120));",
                  "});",
                  "const expectedOffers = {",
                  "  'The Grand Palace': 115,",
                  "  'Metro Suites': 95,",
                  "  'Lotus Residency': 105,",
                  "  'Connaught Court': 90",
                  "};",
                  "const expectedMinimumPrice = 90;",
                  "pm.test('filtered response has the exact deduped Delhi count', function () {",
                  "  // supplierData.ts: Grand Palace min(120,115)=115, Metro min(95,100)=95, Lotus min(110,105)=105, Connaught Court=90; 4 offers are in 90-120.",
                  "  pm.expect(body.length).to.equal(4);",
                  "});",
                  "pm.test('filtered response contains the expected deduped hotels and prices', function () {",
                  "  Object.keys(expectedOffers).forEach((name) => {",
                  "    const hotel = body.find((item) => item.name === name);",
                  "    pm.expect(hotel, name + ' should be present').to.exist;",
                  "    pm.expect(hotel.price, name + ' deduped price').to.equal(expectedOffers[name]);",
                  "  });",
                  "  pm.expect(Math.min.apply(null, body.map((hotel) => hotel.price))).to.equal(expectedMinimumPrice);",
                  "});"
                ]
              }
            }
          ]
        },
