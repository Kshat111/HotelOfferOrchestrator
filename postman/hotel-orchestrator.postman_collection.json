      "name": "Health check",
      "item": [
        {
          "name": "Health - all healthy",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('overall status is ok', function () { pm.expect(body.status).to.equal('ok'); });",
                  "pm.test('both suppliers are up', function () {",
                  "  pm.expect(body.suppliers.supplierA.status).to.equal('up');",
                  "  pm.expect(body.suppliers.supplierB.status).to.equal('up');",
                  "});",
                  "pm.test('Redis and Temporal are up', function () {",
                  "  pm.expect(body.redis.status).to.equal('up');",
                  "  pm.expect(body.temporal.status).to.equal('up');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
